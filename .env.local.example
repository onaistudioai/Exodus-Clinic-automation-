# ─────────────────────────────────────────────────────────────────────────────
# Painel AIOS — variáveis de ambiente
#
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Em produção, configure estas variáveis no painel da Vercel (Settings → Env).
# ─────────────────────────────────────────────────────────────────────────────

# Banco: conecta como app_painel (NÃO-dono, NOBYPASSRLS). É esse role que faz a
# RLS constranger de verdade — não use a credencial de dono da aplicação.
# Criado por .planning/seguranca/000-roles.sql.
DATABASE_URL=postgresql://app_painel:TROCAR_SENHA@HOST.neon.tech/neondb?sslmode=verify-full

# Só para Postgres local sem TLS. É IGNORADO em produção (o app lança erro se
# alguém tentar usar) — a conexão carrega dado de saúde e precisa de TLS verificado.
# PGSSL_DISABLE=1

# CA em PEM, apenas se o banco usar autoridade própria. Neon/Hetzner usam CA
# pública, então normalmente pode ficar de fora.
# PGSSL_CA_CERT=

# Tamanho do pool. Suba junto com a cota de conexões do Postgres.
# DB_POOL_MAX=10

# Segredo de assinatura do JWT de sessão.
#   openssl rand -base64 32
# Trocar este valor derruba todas as sessões ativas (é o comportamento certo
# se houver suspeita de comprometimento).
AUTH_SECRET=TROCAR_openssl_rand_base64_32

# Pepper do hash de CPF — segredo que vive FORA do banco. Sem ele, quem
# roubasse o banco poderia testar CPFs por força bruta contra os hashes.
# ⚠️ Trocar este valor INVALIDA todos os hashes existentes: a busca por CPF
# para de encontrar pacientes já cadastrados. Só troque com plano de remigração.
CPF_PEPPER=TROCAR_segredo_pepper

# Segredos HMAC das integrações da SOFIA (n8n → /api/sofia/*).
# Formato: clinicaId:segredo, separados por vírgula. UM SEGREDO POR CLÍNICA —
# assim o vazamento de um não expõe as outras, e é o próprio segredo que
# identifica o tenant (nunca o corpo da requisição).
#   openssl rand -hex 32
# Mínimo 32 caracteres, validado na inicialização.
# Contrato completo em docs/API-SOFIA.md.
SOFIA_HMAC_SECRETS=2:TROCAR_openssl_rand_hex_32
